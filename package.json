{
  "name": "prosemap",
  "version": "0.2.0",
  "description": "A local-first AI Markdown and Mermaid editor for macOS and Windows.",
  "license": "MIT",
  "repository": "https://github.com/kobe8bryant24lakers/prosemap",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --bundles nsis msi"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2.11.1",
