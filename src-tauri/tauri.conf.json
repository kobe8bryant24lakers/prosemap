{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨流 Markdown Studio",
  "version": "0.1.0",
  "identifier": "com.moliu.markdownstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://moliu-markdown-studio.ko8e24lakers.chatgpt.site/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "墨流 Markdown Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true
  }
}
